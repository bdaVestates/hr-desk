rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function userDoc() { return /databases/$(db)/documents/users/$(request.auth.uid); }
    function role() { return signedIn() && exists(userDoc()) ? get(userDoc()).data.role : 'none'; }
    function isAdmin() { return role() == 'admin'; }
    function canEdit() { return role() in ['admin', 'editor']; }
    function canView() { return role() in ['admin', 'editor', 'viewer']; }
    function setupDone() { return exists(/databases/$(db)/documents/meta/setup); }
    function invite() { return /databases/$(db)/documents/invites/$(myEmail()); }

    // One-time setup: the first person to set up HR Desk becomes admin.
    match /meta/setup {
      allow read: if signedIn();
      allow create: if signedIn() && !setupDone()
        && request.resource.data.adminUid == request.auth.uid
        && getAfter(userDoc()).data.role == 'admin';
      allow update, delete: if false;
    }

    // Who has access and with which role.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == myEmail()
        && (
          // first admin, created together with meta/setup
          (request.resource.data.role == 'admin' && !setupDone()
             && getAfter(/databases/$(db)/documents/meta/setup).data.adminUid == uid)
          ||
          // invited person claiming their invite (email must be confirmed)
          (request.auth.token.email_verified == true && exists(invite())
             && request.resource.data.role == get(invite()).data.role)
        );
      // admins manage everyone else; nobody can change or remove their own access
      allow update: if isAdmin() && request.auth.uid != uid
        && request.resource.data.role in ['admin', 'editor', 'viewer']
        && request.resource.data.email == resource.data.email;
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // Pending invitations, keyed by lower-case email.
    match /invites/{email} {
      allow read: if isAdmin() || (signedIn() && myEmail() == email);
      allow create, update: if isAdmin() && request.resource.data.role in ['admin', 'editor', 'viewer'];
      allow delete: if isAdmin() || (signedIn() && myEmail() == email);
    }

    // Staff records (no salaries here).
    match /employees/{id} {
      allow read: if canView();
      allow create, update: if canEdit() && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Individual salaries: admins only.
    match /pay/{id} {
      allow read, write: if isAdmin();
    }

    // Company salary totals that editors and viewers may see.
    match /stats/{doc} {
      allow read: if canView();
      allow write: if isAdmin();
    }

    // Change log: anyone who can edit adds entries; only admins read; nobody edits or deletes.
    match /audit/{id} {
      allow read: if isAdmin();
      allow create: if canEdit() && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
